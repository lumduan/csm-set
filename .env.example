# TradingView authentication (optional — lifts the 5,000-bar anonymous cap)
# Provide TradingView session cookies as a JSON object on a single line.
# Required key: sessionid. Recommended companions: sessionid_sign, device_t, tv_ecuid.
# Extract via your browser's devtools → Application → Cookies → tradingview.com.
# TVKIT_AUTH_TOKEN={"sessionid":"...","sessionid_sign":"...","device_t":"...","tv_ecuid":"..."}

# Application
CSM_ENV=development
CSM_DATA_DIR=./data
CSM_LOG_LEVEL=INFO

# Public mode — set true to disable all data fetch/write operations
# Anyone cloning the repo should leave this as true (default in Docker)
CSM_PUBLIC_MODE=false

# Results directory — pre-computed outputs committed to git
CSM_RESULTS_DIR=./results

# API
CSM_API_HOST=0.0.0.0
CSM_API_PORT=8000

# API key for private-mode protected endpoints (X-API-Key header).
# Leave unset for local development — a startup WARNING reminds you auth is disabled.
# Set to a strong random secret for any deployment beyond loopback.
# CSM_API_KEY=changeme-strong-random-string

# UI
CSM_UI_PORT=8080

# Scheduler (Asia/Bangkok timezone, owner-only — ignored when public_mode=true)
CSM_REFRESH_CRON=0 18 * * 1-5

# OHLCV source (feature-market-data-engine Phase 3).
#   parquet (default) — fetch from tvkit and persist the local Parquet store
#                       (unchanged legacy behaviour; needs TVKIT_AUTH_TOKEN).
#   db                — read pre-fetched bars from the Market Data Engine read
#                       API; csm-set never touches tvkit (no cookie required).
CSM_OHLCV_SOURCE=parquet
# Required when CSM_OHLCV_SOURCE=db: Market Data Engine read-API base URL.
# Inside quant-network use the service name; on the host use http://localhost:8300.
# CSM_MARKET_DATA_ENGINE_BASE_URL=http://quant-marketdata-engine:8000
# Optional: X-API-Key for the engine read API. Only needed when the engine sets
# its own MARKETDATA_ENGINE_API_KEY. Never committed; never logged.
# CSM_MARKET_DATA_ENGINE_API_KEY=your_marketdata_engine_read_key

# quant-infra-db write-back (opt-in). Set CSM_DB_WRITE_ENABLED=true plus all
# three DSNs below to mirror equity curve, trades, daily performance, portfolio
# snapshots, signals, backtest results, and model params to the shared stack.
# See README.md § "Persisting to quant-infra-db" for the full setup.
CSM_DB_WRITE_ENABLED=false
# Required when CSM_DB_WRITE_ENABLED=true: csm-set's own Postgres DB
# (equity_curve, trade_history, backtest_log).
# CSM_DB_CSM_SET_DSN=postgresql://postgres:<pass>@quant-postgres:5432/db_csm_set
# Optional when CSM_DB_WRITE_ENABLED=true: read-only DSN to the cross-strategy
# Postgres gateway DB. Used by GatewayAdapter.read_daily_performance and
# read_portfolio_snapshots for history queries. The write-side now goes via
# the HTTP ingestion contract below — keep this set only if you still need
# the legacy read methods.
# CSM_DB_GATEWAY_DSN=postgresql://postgres:<pass>@quant-postgres:5432/db_gateway
# Required when CSM_DB_WRITE_ENABLED=true: gateway base URL for the standard
# ingestion contract POST /api/v1/ingest/daily-report. Inside Docker this is
# the service name on quant-network; on the host use http://localhost:8080.
# CSM_GATEWAY_BASE_URL=http://quant-api-gateway:8000
# Required when CSM_GATEWAY_BASE_URL is set: shared INTERNAL_API_KEY (the same
# value the gateway exposes via its own INTERNAL_API_KEY env var) presented
# as the X-API-Key header on every daily-report POST.
# CSM_GATEWAY_API_KEY=your_shared_internal_api_key
# Required when CSM_DB_WRITE_ENABLED=true: shared Mongo (csm_logs) for
# signal_snapshots, backtest_results, model_params.
# CSM_MONGO_URI=mongodb://quant-mongo:27017/
